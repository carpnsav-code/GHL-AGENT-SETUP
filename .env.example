# GoHighLevel / LeadConnector API v2 credentials
#
# GHL_API_TOKEN — either:
#   1. A Private Integration Token (starts with "pit-")
#      Sub-account: Settings -> Private Integrations -> Create new integration
#      Agency:      Settings -> Private Integrations (agency-level token)
#   2. An OAuth 2.0 access token obtained from the marketplace app flow
GHL_API_TOKEN=

# The sub-account (location) the agent operates on.
# Find it at: Settings -> Business Profile -> Location ID
GHL_LOCATION_ID=

# Optional overrides
# GHL_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28
