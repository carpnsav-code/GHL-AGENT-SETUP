# GoHighLevel / LeadConnector API v2 credentials
#
# GHL_API_TOKEN — either:
#   1. A Private Integration Token (starts with "pit-")
#      Sub-account: Settings -> Private Integrations -> Create new integration
#      Agency:      Settings -> Private Integrations (agency-level token)
#   2. An OAuth 2.0 access token obtained from the marketplace app flow
GHL_API_TOKEN=

# The sub-account (location) the agent operates on.
# Find it at: Settings -> Business Profile -> Location ID
GHL_LOCATION_ID=

# Optional overrides
# GHL_BASE_URL=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28

# ---------------------------------------------------------------------------
# Mint Concrete crew app (npm run app)
#
# Port to serve on (default 3000)
# PORT=3000
# Where the SQLite database lives (default data/mint-concrete.sqlite)
# MC_DB_FILE=data/mint-concrete.sqlite
# Optional join code: when set, only people who know it can create an account.
# MC_JOIN_CODE=
# Require a GPS fix to clock in/out (default on). Set to 0 to make it optional.
# MC_REQUIRE_LOCATION=1
# Force Secure cookies on (1) or off (0). Auto-detected from HTTPS by default.
# MC_SECURE_COOKIES=
